# The handoff's design files ship a copy of the product photography so they render
# standalone. The originals live at apps/universal/assets/images/ and the handoff's own
# §9 says not to re-add them — two megabytes of duplicate binaries, permanent in git, for
# artwork the repository already has.
design_handoff_wellness_green/**/assets/

# HealthZone.dc.html reads this to fill its image slots, and it is 150 KB of base64
# photography the repository already holds as real files. It belongs to the design project
# rather than to the code — see CLAUDE.md, "Opening it".
.image-slots.state.json

# `> nul` is a cmd.exe redirect. Run under bash — which is what the Bash tool and most
# scripts here use — it writes a real file instead of discarding the output.
nul

# Saved browser session for e2e/screenshot.mjs — never commit.
apps/universal/e2e/.auth/

# design-sync (staged converter, generated bundle, machine state)
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
packages/design-system/dist/
