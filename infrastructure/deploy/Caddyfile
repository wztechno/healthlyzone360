# TLS termination for the test instance.
#
# Caddy obtains and renews a Let's Encrypt certificate for SITE_ADDRESS by
# itself; nip.io hostnames (e.g. 203-0-113-5.nip.io) resolve to the embedded
# address with no DNS records to create, and Let's Encrypt issues for them
# normally, so an instance can have real HTTPS without owning a domain.

{
	# No `email` directive on purpose. Caddy registers with Let's Encrypt
	# anonymously, which costs only the expiry-warning mails — and an
	# `email {$ACME_EMAIL}` line whose variable is unset expands to a bare
	# `email`, which is a hard parse error that crash-loops the container.
	# To receive those warnings, add `email you@example.com` here literally.
	admin off
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# X-Forwarded-For is *set* to the immediate peer rather than appended to.
	# The framework trusts this proxy wholesale (bootstrap/app.php), which is
	# only sound if a client cannot smuggle its own X-Forwarded-For through —
	# replacing the header rather than extending it is what makes that true.
	reverse_proxy web:80 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format console
	}
}
