{
    "name": "universal",
    "version": "0.0.0",
    "private": true,
    "main": "expo-router/entry",
    "scripts": {
        "dev": "expo start",
        "android": "expo start --android",
        "ios": "expo start --ios",
        "web": "expo start --web",
        "build:web": "expo export -p web --clear",
        "build:web:api": "expo export -p web --output-dir dist-api --clear",
        "doctor": "expo-doctor",
        "lint": "eslint . --max-warnings=0",
        "typecheck": "tsc --noEmit",
        "test": "jest --ci",
        "e2e": "playwright test",
        "e2e:acceptance": "playwright test --config playwright.acceptance.config.ts"
    },
    "dependencies": {
        "@expo-google-fonts/ibm-plex-sans-arabic": "^0.4.2",
        "@expo-google-fonts/inter": "^0.4.2",
        "@healthy360/analytics": "workspace:*",
        "@healthy360/api-client": "workspace:*",
        "@healthy360/design-system": "workspace:*",
        "@healthy360/design-tokens": "workspace:*",
        "@healthy360/domain-types": "workspace:*",
        "@healthy360/i18n": "workspace:*",
        "@healthy360/nutrition": "workspace:*",
        "@healthy360/permissions": "workspace:*",
        "@healthy360/validation": "workspace:*",
        "@react-native-community/netinfo": "12.0.1",
        "@tanstack/react-query": "^5.101.4",
        "expo": "~57.0.9",
        "expo-constants": "~57.0.8",
        "expo-font": "~57.0.1",
        "expo-linking": "~57.0.4",
        "expo-localization": "~57.0.1",
        "expo-router": "~57.0.9",
        "expo-secure-store": "~57.0.1",
        "expo-splash-screen": "~57.0.5",
        "expo-status-bar": "~57.0.1",
        "expo-system-ui": "~57.0.2",
        "i18next": "^26.3.6",
        "nativewind": "4.2.6",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-hook-form": "^7.83.0",
        "react-i18next": "^17.0.11",
        "react-native": "0.86.2",
        "react-native-gesture-handler": "~2.32.0",
        "react-native-reanimated": "4.5.1",
        "react-native-safe-area-context": "~5.7.0",
        "react-native-screens": "~4.26.0",
        "react-native-web": "~0.21.0",
        "react-native-worklets": "0.10.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.12.1",
        "@healthy360/testing": "workspace:*",
        "@playwright/test": "^1.62.0",
        "@testing-library/react-native": "^14.0.1",
        "@types/jest": "^29.5.14",
        "@types/react": "~19.2.2",
        "jest": "^29.7.0",
        "jest-expo": "~57.0.3",
        "tailwindcss": "~3.4.19",
        "test-renderer": "^1.2.0",
        "typescript": "~6.0.3"
    }
}
