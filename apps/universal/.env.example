# Every build talks to the Laravel API (ADR-0013 - there is no mock mode).

# Match apps/api APP_URL when using `php artisan serve` (port 8000).
# Docker Compose API is typically http://localhost:8080 — override locally if needed.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

APP_MODE=all-dev
APP_ENV=development
