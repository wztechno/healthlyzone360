APP_NAME=Healthy360
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (docker compose service "postgres", published on localhost).
# Local development credentials only - see infrastructure/docker/postgres/init.
#
# Runtime runs as healthy360_app: it owns nothing, holds NOBYPASSRLS, and is
# therefore subject to the row-level security policies (ADR-0007). Schema
# changes and seeding run as healthy360_migrator through the separate
# pgsql_migrations connection:
#   composer db:migrate  /  composer db:fresh
#   php artisan migrate --database=pgsql_migrations --seed
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=healthy360
DB_USERNAME=healthy360_app
DB_PASSWORD=h360_app_local
DB_MIGRATIONS_USERNAME=healthy360_migrator
DB_MIGRATIONS_PASSWORD=h360_migrator_local

# First-party clients. SANCTUM_STATEFUL_DOMAINS lists the origins that may
# hold a cookie session (Expo web dev server, Expo Router web export, Expo
# Go); every other client authenticates with a bearer token from
# POST /api/v1/auth/token. SESSION_DOMAIN stays null so the cookie is bound
# to the exact API host.
FRONTEND_URL=http://localhost:8081
# FRONTEND_URLS is the CORS allow-list (config/cors.php): every origin an Expo build is
# served from. Comma-separated, no trailing slashes.
FRONTEND_URLS=http://localhost:4173,http://localhost:4174,http://localhost:8081,http://localhost:19006
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,localhost:8081,localhost:8082,localhost:19006

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit (docker compose service "mailpit"; UI on http://localhost:8025)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@healthy360.local"
MAIL_FROM_NAME="${APP_NAME}"

# Garage S3-compatible object storage (docker compose service "garage").
# Local development credentials only - created by scripts/storage-init.
AWS_ACCESS_KEY_ID=GK0123456789abcdef01234567
AWS_SECRET_ACCESS_KEY=7d6c5b4a3928170605f4e3d2c1b0a9887766554433221100ffeeddccbbaa9988
AWS_DEFAULT_REGION=garage
AWS_BUCKET=healthy360-local
AWS_ENDPOINT=http://127.0.0.1:3900
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"
