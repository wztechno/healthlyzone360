    "howItWorks": {
        "title": "How Healthy360 works",
        "subtitle": "Four steps, from a target to a week you can cook or order.",
        "step": {
            "tell": {
                "title": "Tell us what has to be true",
                "body": "Your measurements, how you move, what you are working towards, and everything you cannot or will not eat — allergies, medical restrictions, religious requirements and plain dislikes, each recorded differently because each behaves differently."
            },
            "target": {
                "title": "See a target, and where it came from",
                "body": "An energy figure and protein, carbohydrate, fat and fibre grams, with the method named and the assumptions listed. It is an estimate, and it says so."
            },
            "plan": {
                "title": "Fill the week",
                "body": "Lock what you want to keep, regenerate what you do not, swap a meal for one that fits, and watch the day's totals move as you go."
            },
            "eat": {
                "title": "Cook it, or have it delivered",
                "body": "Every entry is either something you make or something a kitchen brings. Mix the two however suits the week."
            }
        },
