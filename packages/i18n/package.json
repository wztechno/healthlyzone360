{
    "name": "@healthy360/i18n",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "sideEffects": false,
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./catalogues/*": "./catalogues/*",
        "./package.json": "./package.json"
    },
    "scripts": {
        "gen:keys": "node scripts/generate-keys.mjs",
        "gen:keys:check": "node scripts/generate-keys.mjs --check",
        "gen:pseudo-locale": "node scripts/generate-pseudo-locale.mjs",
        "i18n:check": "node scripts/check-catalogues.mjs",
        "lint": "eslint . --max-warnings=0",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@healthy360/domain-types": "workspace:*",
        "i18next": "^26.3.6",
        "react-i18next": "^17.0.11"
    },
    "peerDependencies": {
        "react": ">=19.0.0",
        "react-native": ">=0.80.0"
    },
    "peerDependenciesMeta": {
        "react-native": {
            "optional": true
        }
    },
    "devDependencies": {
        "@healthy360/testing": "workspace:*",
        "@types/react": "~19.2.2",
        "react": "19.2.3",
        "vitest": "^4.1.10"
    }
}
