{
    "name": "@healthy360/design-tokens",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "sideEffects": [
        "./generated/tokens.css"
    ],
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./generators": "./src/generators/index.ts",
        "./tailwind-preset": "./generated/tailwind-preset.cjs",
        "./tokens.css": "./generated/tokens.css",
        "./native": "./generated/tokens.native.ts",
        "./package.json": "./package.json"
    },
    "scripts": {
        "build:tokens": "node scripts/build-tokens.mjs",
        "build:tokens:check": "node scripts/build-tokens.mjs --check",
        "lint": "eslint . --max-warnings=0",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "devDependencies": {
        "@healthy360/testing": "workspace:*",
        "vitest": "^4.1.10"
    }
}
